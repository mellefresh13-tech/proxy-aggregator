{
  "manifest_version": 3,
  "name": "DomikVPN",
  "version": "0.2.0",
  "description": "Simple browser VPN powered by a live proxy catalog.",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "DomikVPN",
    "default_popup": "popup.html"
  }
}
